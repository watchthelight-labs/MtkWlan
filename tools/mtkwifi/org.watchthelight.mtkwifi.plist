<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>org.watchthelight.mtkwifi</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/mtkwifi</string>
		<string>autojoin</string>
		<string>--wait</string>
		<string>90</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/Users/Shared/legion-diag/mtkwifi.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/Shared/legion-diag/mtkwifi.log</string>
</dict>
</plist>
